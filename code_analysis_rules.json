{
  "fail_on": "warning",
  "max_lines_per_file": {
    "enabled": true,
    "warning": 300,
    "error": 500
  },
  "pmd_duplicates": {
    "enabled": true,
    "minimum_tokens": 100
  },
  "kotlin_complexity": {
    "enabled": true,
    "cyclomatic_complexity": {
      "warning": 10,
      "error": 15,
      "exceptions": []
    },
    "function_length": {
      "warning": 50,
      "error": 100,
      "exceptions": []
    },
    "parameter_count": {
      "warning": 5,
      "error": 8,
      "exceptions": []
    }
  }
}

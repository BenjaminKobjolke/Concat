# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Windows batch files must be CRLF - cmd.exe misparses LF-only scripts
# (e.g. "set" lines break into fragments, vars stay empty)
*.bat text eol=crlf
*.cmd text eol=crlf

# Third-party crates carried with a patch (see src/patches/README.md):
# upstream code, so GitHub's language bar counts Concat's own.
src/patches/** linguist-vendored